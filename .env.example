# AUTOMATON TRADING — Alpaca credentials (never commit this file)
# Get paper keys at https://app.alpaca.markets -> Paper Trading -> API Keys.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Optional mode-specific keys (take precedence over the generic pair above).
# ALPACA_PAPER_API_KEY_ID=
# ALPACA_PAPER_API_SECRET_KEY=
# ALPACA_LIVE_API_KEY_ID=
# ALPACA_LIVE_API_SECRET_KEY=

# Engine mode: sim | paper | live. Live additionally requires allowLive=true and
# the LIVE_ARMED marker file in the state directory.
AUTOMATON_MODE=paper

# Optional overrides (defaults shown).
# AUTOMATON_STATE_DIR=D:\CounterStikers\automaton-data
# AUTOMATON_ENV_FILE=D:\CounterStikers\.env
# AUTOMATON_AUTO_START=false
# AUTOMATON_CYCLE_SEC=300
# AUTOMATON_POPULATION_INITIAL=3
# AUTOMATON_POPULATION_CAP=10
# AUTOMATON_ENDOWMENT_USD=5000
# AUTOMATON_ALLOW_LIVE=false
# AUTOMATON_SYMBOLS=AAPL,MSFT,NVDA,AMD,META,AMZN,GOOGL,TSLA,SPY,QQQ
