{
  "name": "@local/automaton-trading",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mortality-engineered multi-agent trading system for Alpaca (paper/live): six roles, a death rule, replication with mutation, and an external Reaper — agent tools plus a Web UI population dashboard.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./src/*": "./src/*"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "src/**/*.js",
    "bin/**/*.mjs",
    "docs/*.md",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node --test test/plugin.test.js"
  }
}
