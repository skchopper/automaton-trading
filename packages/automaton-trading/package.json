{
  "name": "@local/automaton-trading",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "displayName": "MEAT — Mortality Engineered Auto-Trading",
  "description": "MEAT — Mortality Engineered Auto-Trading: mortality-engineered multi-agent trading for Alpaca (paper/live). Six roles with stoplines, a death rule, replication with mutation, an external Reaper, a per-agent isolated hourly research analyst, and an operator control panel (research cadence, leaderboards, configurable winner rewards).",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./src/*": "./src/*"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "src/**/*.js",
    "bin/**/*.mjs",
    "docs/*.md",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node --test test/plugin.test.js"
  }
}
